# Copie para .env e preencha. O .env nunca deve ir para o git.

# --- MetaTrader 5 ---
# Caminho do terminal64.exe de uma instalação do MT5 SEPARADA, logada só na conta demo.
# Deixe vazio para usar o terminal padrão.
MT5_PATH=C:\MT5-Demo\terminal64.exe

# Recomendado: fixa a conta esperada. O servidor confere login e servidor a cada uso e se recusa a
# trabalhar se o terminal estiver em outra conta. Também faz login automático nessa conta ao iniciar.
# A senha pode ficar vazia se estiver salva no terminal ("Salvar senha" ao logar).
# Se vazios, usa a conta que estiver logada no terminal, sem bloquear trocas.
MT5_LOGIN=
MT5_PASSWORD=
# Nome exato do servidor demo, como aparece no terminal/e-mail da Exness (ex.: Exness-MT5Trial11)
MT5_SERVER=

# Sufixo dos símbolos (ex.: m -> EURUSDm). Vazio = detecção automática.
SYMBOL_SUFFIX=

# --- SEC EDGAR (fundamentos de ações dos EUA) ---
# A SEC exige identificação: "Seu Nome seu@email.com"
SEC_USER_AGENT=

# --- Journal (operações da conta demo) ---
# Banco SQLite. Vazio = pasta trading-mcp dentro do seu usuário (fora do OneDrive e do AppData).
JOURNAL_PATH=
# Pasta das exportações (CSV) e cópias de segurança. Vazio = journal_export dentro do projeto.
JOURNAL_EXPORT_DIR=

# --- Instrumentos operados (reação a eventos e contexto entre ativos) ---
# Separados por vírgula, sem sufixo. Vazio = USTEC,US30,JP225,XAUUSD,GBPUSD,EURUSD,BTCUSD,UKOIL,DXY
INSTRUMENTOS=

# --- Reações guardadas (estatísticas por tipo de surpresa) ---
# Banco SQLite. Vazio = reacoes.sqlite3 na mesma pasta padrão do journal.
REACOES_PATH=

# --- Limites de risco e propostas de operação (nada é enviado ao MT5) ---
# Porcentagens do saldo do INÍCIO do dia de mercado (vira às 17:00 de Nova York) e da semana (domingo 17:00).
# Vazio = 1,25% por operação, 5% de perda no dia e 25% na semana.
RISCO_POR_OPERACAO_PCT=
PERDA_MAXIMA_DIA_PCT=
PERDA_MAXIMA_SEMANA_PCT=
# Banco SQLite das propostas. Vazio = propostas.sqlite3 na mesma pasta padrão do journal.
PROPOSTAS_PATH=

# --- Execução de propostas (só conta demo, com aprovação numa janela do Windows) ---
# sim = permite `executar_proposta`. Também é preciso, no MT5, ligar o Algo Trading e desmarcar "Desativar negociação
# algorítmica via API Python externa" (Ferramentas > Opções > Expert Advisors). Vazio = nao.
EXECUCAO_HABILITADA=
